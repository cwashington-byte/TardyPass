rules_version = '2';

// TardyPass — student PII lives here (names, grade, schedule), so the posture is
// default-deny with explicit membership gating. Being signed in with a Google
// account is NOT enough: an admin must create a member doc for that uid. This is
// what keeps a student's own Workspace account from reading the roster.
//
// Roles are 'admin' | 'staff' | 'device'. A 'device' is a shared hallway printer
// signed in with its own dedicated Workspace account, never a person. Because
// many people use one printer, a device may attribute a pass to any provisioned
// member rather than only to itself — the person identifies themselves in the
// app. That identity is CLAIMED, not proven. What these rules still guarantee is
// (a) which machine produced the pass, and (b) that the claimed author is a real
// member of this school. A personal account keeps the old, stronger guarantee:
// it can only ever attribute a pass to itself.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function memberPathFor(schoolId, uid) {
      return /databases/$(database)/documents/schools/$(schoolId)/members/$(uid);
    }

    function memberPath(schoolId) {
      return memberPathFor(schoolId, request.auth.uid);
    }

    function isMember(schoolId) {
      return isSignedIn() && exists(memberPath(schoolId));
    }

    // Defaulted, so a member doc written before roles existed still resolves —
    // this matches the client, which reads a missing role as "staff".
    function roleOf(schoolId) {
      return get(memberPath(schoolId)).data.get('role', 'staff');
    }

    function isAdmin(schoolId) {
      return isMember(schoolId) && roleOf(schoolId) == 'admin';
    }

    // A shared printer. It can never also be an admin — role is one string — and
    // members/{uid} writes stay admin-only, so a device cannot promote itself.
    function isDevice(schoolId) {
      return isMember(schoolId) && roleOf(schoolId) == 'device';
    }

    match /schools/{schoolId} {
      // School doc itself: readable by members, writable only by admins.
      allow read: if isMember(schoolId);
      allow write: if isAdmin(schoolId);

      function invitePath(schoolId) {
        return /databases/$(database)/documents/schools/$(schoolId)/invites/$(request.auth.token.email.lower());
      }

      function hasInvite(schoolId) {
        return isSignedIn() && exists(invitePath(schoolId));
      }

      function passHasStudent() {
        return request.resource.data.studentId is string
               && request.resource.data.studentId.size() > 0;
      }

      // A person attributes a pass only to themselves, and may not dress it up as
      // having come from a printer. The null tolerance matters: the Firestore SDK
      // writes an explicit null for a key set to null, so "key absent" alone is
      // not a safe test.
      function selfAttributedPass() {
        return request.resource.data.staffUid == request.auth.uid
               && (!('deviceUid' in request.resource.data)
                   || request.resource.data.deviceUid == null);
      }

      // A printer stamps its own uid as the issuing machine and names a real
      // member — anyone except itself — as the claimed author. Refusing
      // self-attribution is what stops a pass quietly reading "issued by
      // Pass Printer 01" when nobody picked a name.
      function deviceAttributedPass(schoolId) {
        return request.resource.data.deviceUid == request.auth.uid
               && request.resource.data.staffUid is string
               && request.resource.data.staffUid != request.auth.uid
               && request.resource.data.staffName is string
               && request.resource.data.staffName.size() > 0
               && exists(memberPathFor(schoolId, request.resource.data.staffUid));
      }

      match /members/{uid} {
        // You can always read your own membership record, member or not —
        // otherwise a newly invited user can't check whether they're already
        // provisioned, and the invite claim below can never run.
        allow read: if isMember(schoolId) || (isSignedIn() && request.auth.uid == uid);
        allow update, delete: if isAdmin(schoolId);

        // Admins provision anyone. A newly invited staff member provisions only
        // themselves, only with the role the admin chose — so an invite can't be
        // escalated to admin by the person claiming it.
        allow create: if isAdmin(schoolId)
                      || (isSignedIn()
                          && request.auth.uid == uid
                          && hasInvite(schoolId)
                          && request.resource.data.role == get(invitePath(schoolId)).data.role
                          && request.resource.data.email == request.auth.token.email);
      }

      match /invites/{email} {
        // An invitee must be able to see their own invite to claim it. Listing
        // every pending invite is admin-only — a shared printer has no business
        // enumerating staff email addresses.
        allow read: if isAdmin(schoolId)
                    || (isSignedIn() && request.auth.token.email.lower() == email);
        allow create, update: if isAdmin(schoolId);
        // Admins revoke; the invitee clears their own once claimed.
        allow delete: if isAdmin(schoolId)
                      || (isSignedIn() && request.auth.token.email.lower() == email);
      }

      match /students/{studentId} {
        allow read: if isMember(schoolId);
        // Roster changes come from CSV import (admin) or the SIS sync function
        // (service account, which bypasses rules).
        allow create, update: if isAdmin(schoolId);
        allow delete: if isAdmin(schoolId);
      }

      match /passes/{passId} {
        allow read: if isMember(schoolId);

        // Exactly one branch applies to any caller, because a member has exactly
        // one role. Three document accesses worst case (own member doc, plus the
        // claimed member doc) — the per-request limit is ten, so don't add
        // get()s here casually.
        allow create: if isMember(schoolId)
                      && passHasStudent()
                      && (isDevice(schoolId)
                            ? deviceAttributedPass(schoolId)
                            : selfAttributedPass());

        // Passes are an audit record: no edits, and only admins may remove them.
        allow update: if false;
        allow delete: if isAdmin(schoolId);
      }
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
